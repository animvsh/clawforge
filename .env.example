# ClawForge local/Brev environment
#
# Copy to `.env.local` for local development or `.env` on Brev.
# Store real values in Brev, Railway, Cloudflare, Supabase, or local shell secret stores.
# Never commit real secret values.

# Intelligence provider selection:
# - auto: Nemotron when NVIDIA_API_KEY exists, then MiniMax when MiniMax credentials exist, then mock.
# - nemotron: force NVIDIA Nemotron/NIM path.
# - minimax: force MiniMax path.
# - mock: deterministic local demo path.
AGENT_PROVIDER=mock

# NVIDIA Nemotron / NIM
NVIDIA_API_KEY=
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional local NIM / NGC setup for Brev
NGC_CLI_API_KEY=

# NemoClaw / sandbox routing
NEMOCLAW_PROVIDER=routed
NEMOCLAW_MODEL=
NEMOCLAW_SANDBOX_NAME=sentinelclaw-demo

# Railway-hosted ClawForge uses this to call Brev and create real NemoClaw VMs.
# Keep the value only in Railway secrets.
BREV_TOKEN=

# MiniMax Cloud fallback
MINIMAX_API_KEY=
MINIMAX_PLAN_KEY=
MINIMAX_MODEL=minimax/token-plan

# Optional Supabase accounts and persistence
VITE_SUPABASE_URL=https://mfslvyqvkutazsimsrhu.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional integration provider use from Brev
COMPOSIO_API_KEY=
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp
COMPOSIO_DASHBOARD_URL=https://dashboard.composio.dev/aalang_workspace/clawforge/getting-started
COMPOSIO_PHONE_NUMBER=
AGENTMAIL_API_KEY=
VAPI_API_KEY=

# Optional Pipedream Connect fallback for tool access.
# Used when an agent needs app connections that are not available through the primary integrations layer.
PIPEDREAM_PROJECT_ID=
PIPEDREAM_ENVIRONMENT=production
PIPEDREAM_ACCESS_TOKEN=
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=

# Optional NemoClaw installer override.
# Set only when the official installer URL or pinned installer path is known.
NEMOCLAW_INSTALL_URL=

# Optional OpenHands predeploy sandbox settings.
OPENHANDS_MODE=disabled
OPENHANDS_API_BASE_URL=
OPENHANDS_API_KEY=
OPENHANDS_SANDBOX_IMAGE=
PREDEPLOY_SANDBOX_TIMEOUT_MS=120000

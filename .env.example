# ClawForge local/Brev configuration.
# Copy to .env for local development only. Store real values in Brev, Railway,
# Cloudflare, or local shell secret stores. Do not commit real secrets.
AGENT_PROVIDER=mock

# Supabase public client config placeholders.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NVIDIA / Nemotron / NemoClaw / NIM placeholders.
NVIDIA_API_KEY=
NVIDIA_NEMOTRON_MODEL=
NVIDIA_BASE_URL=
NGC_CLI_API_KEY=
NEMOCLAW_PROVIDER=routed
NEMOCLAW_MODEL=
NEMOCLAW_SANDBOX_NAME=sentinelclaw-demo

# MiniMax placeholders.
MINIMAX_API_KEY=
MINIMAX_PLAN_KEY=
MINIMAX_MODEL=

# Optional persistence and integration placeholders.
SUPABASE_SERVICE_ROLE_KEY=
COMPOSIO_API_KEY=
